# Yönetim paneli girişi
ADMIN_USERNAME=tusa
ADMIN_PASSWORD=buraya-guclu-bir-sifre
# Oturum imzası ve e-posta şifresinin şifrelenmesi için kullanılır.
# Üretim sunucusunda: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# İletişim formu taleplerinin kaydedilmesi için açık kalmalı
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# Canonical adres ve Open Graph bağlantıları
NEXT_PUBLIC_SITE_URL=https://sanalanjiyo.tusahastanesi.com

# İçerik, ayar ve taleplerin tutulacağı yazılabilir klasör.
# Deploy dizininin DIŞINDA olmalı; aksi halde her deploy panel
# üzerinden yapılan düzenlemeleri siler.
CONTENT_DIR=/var/www/sanalanjiyo-data
